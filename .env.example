# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# App URLs (used for OAuth redirects, RSVP links, and cross-app CTAs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Mercado Pago — Suas integrações > Credenciais de produção/teste
MERCADOPAGO_ACCESS_TOKEN=your-mp-access-token
# Opcional, mas recomendado: Suas integrações > Webhooks > Chave secreta
MERCADOPAGO_WEBHOOK_SECRET=your-mp-webhook-secret

# Google AdSense — deixe em branco para não exibir anúncios (ex: em dev)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

